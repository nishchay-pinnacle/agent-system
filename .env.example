# Optional storage override. Relative paths resolve against the repository root.
AGENT_SYSTEM_DATA_DIR=data

# Required only for real company research. Placeholder start needs no API key.
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium

# Optional research limits (resolved and persisted once for each new job).
# AGENT_SYSTEM_GENERATION_REQUESTS=60
# AGENT_SYSTEM_FIRECRAWL_REQUESTS=40
# AGENT_SYSTEM_PAGES=30
# AGENT_SYSTEM_INVESTIGATIONS=12
# AGENT_SYSTEM_INVESTIGATION_RETRIEVALS=6
# AGENT_SYSTEM_RETRIEVALS=100
# AGENT_SYSTEM_ACTIVE_SECONDS=1800
# AGENT_SYSTEM_TOTAL_TOKENS=500000
# AGENT_SYSTEM_INPUT_TOKENS=48000
# AGENT_SYSTEM_OUTPUT_TOKENS=6000
# AGENT_SYSTEM_REQUEST_SECONDS=90
