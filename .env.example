# Required. Exact Responses API model with strict tools; no fallback model.
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
OPENAI_MODEL=

RESEARCH_DATA_DIR=data
RESEARCH_MAX_MODEL_CALLS=12
# Token estimates, not old byte allowances. Verify capacity for your model.
RESEARCH_INPUT_TOKEN_LIMIT=96000
RESEARCH_CONTEXT_TOKENS=128000
# Optional verified encoding for models absent from tiktoken's registry:
# RESEARCH_ENCODING=o200k_base
RESEARCH_OUTPUT_TOKENS=8000
RESEARCH_TIMEOUT_SECONDS=120
RESEARCH_MAP_LIMIT=5000
