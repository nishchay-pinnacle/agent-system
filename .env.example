# Required. Set credentials and an exact Responses API model you can access.
# No default or fallback model is selected.
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
OPENAI_MODEL=

# Optional. Relative data paths resolve against the terminal's working directory.
RESEARCH_DATA_DIR=data
RESEARCH_MAX_MODEL_CALLS=12
# Conservative input allowance: serialized UTF-8 bytes + 2048 framing reserve.
RESEARCH_INPUT_ALLOWANCE=96000
RESEARCH_OUTPUT_TOKENS=8000
RESEARCH_TIMEOUT_SECONDS=120
RESEARCH_MAP_LIMIT=5000
