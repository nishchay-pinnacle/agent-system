# Optional storage override. Relative paths resolve against the repository root.
AGENT_SYSTEM_DATA_DIR=data

# Required only for real company research. Placeholder start needs no API key.
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium

# Optional research limits (resolved and persisted once for each new job).
# AGENT_SYSTEM_GENERATION_REQUESTS=120
# AGENT_SYSTEM_FIRECRAWL_REQUESTS=80
# AGENT_SYSTEM_PAGES=60
# AGENT_SYSTEM_INVESTIGATIONS=12
# AGENT_SYSTEM_INVESTIGATION_RETRIEVALS=6
# AGENT_SYSTEM_RETRIEVALS=100
# AGENT_SYSTEM_ACTIVE_SECONDS=3600
# AGENT_SYSTEM_TOTAL_TOKENS=2000000
# AGENT_SYSTEM_INPUT_TOKENS=96000
# AGENT_SYSTEM_OUTPUT_TOKENS=6000
# AGENT_SYSTEM_REQUEST_SECONDS=90
# AGENT_SYSTEM_GENERATION_REQUEST_SECONDS=300
# AGENT_SYSTEM_MAP_LIMIT=5000
# AGENT_SYSTEM_ORIENTATION_OUTPUT_TOKENS=12000

# Version-three role settings. Research roles fall back to OPENAI_MODEL/EFFORT.
# AGENT_SYSTEM_ORIENTATION_MODEL=gpt-6-luna
# AGENT_SYSTEM_COORDINATOR_MODEL=gpt-6-luna
# AGENT_SYSTEM_INVESTIGATOR_MODEL=gpt-6-luna
# AGENT_SYSTEM_QUALITY_MODEL=gpt-6.1-sol
# AGENT_SYSTEM_ORIENTATION_EFFORT=medium
# AGENT_SYSTEM_COORDINATOR_EFFORT=medium
# AGENT_SYSTEM_INVESTIGATOR_EFFORT=medium
# AGENT_SYSTEM_QUALITY_EFFORT=medium
# AGENT_SYSTEM_CONCURRENT_INVESTIGATORS=3
# AGENT_SYSTEM_INVESTIGATOR_GENERATIONS=12
# AGENT_SYSTEM_INVESTIGATOR_PAGES=6
# AGENT_SYSTEM_INVESTIGATOR_ACTIONS=40
# AGENT_SYSTEM_TOOL_ACTIONS=500
# AGENT_SYSTEM_COORDINATOR_OUTPUT_TOKENS=16000
# AGENT_SYSTEM_INVESTIGATOR_OUTPUT_TOKENS=8000
# AGENT_SYSTEM_QUALITY_OUTPUT_TOKENS=12000
